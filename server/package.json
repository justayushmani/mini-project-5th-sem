{
  "name": "yojana-saathi-server",
  "version": "1.0.0",
  "description": "Yojana Saathi - AI-Powered Government Scheme Assistant (Backend)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "db:seed": "node prisma/seed.js",
    "db:reset": "npx prisma migrate reset",
    "ingest": "node scripts/ingestSchemes.js"
  },
  "keywords": ["yojana", "government", "schemes", "india", "ai"],
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "groq-sdk": "^0.33.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "express-rate-limit": "^7.4.0",
    "zod": "^3.23.0",
    "winston": "^3.14.0"
  },
  "devDependencies": {
    "prisma": "^6.0.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
