# ── Core ──
NODE_ENV=development
PORT=5000

# ── Database (PostgreSQL) ──
DATABASE_URL=postgresql://user:password@localhost:5432/yojana_saathi

# ── Authentication ──
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=7d

# ── Frontend URL (for CORS) ──
FRONTEND_URL=http://localhost:5173

# ── Groq AI (required from Phase 7) ──
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Qdrant Vector DB (required from Phase 9) ──
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=yojana_schemes

# ── Embedding Provider ──
EMBEDDING_MODEL=Xenova/multilingual-e5-small
EMBEDDING_CACHE_DIR=.cache/models
